{
  "name": "attendance-bot",
  "version": "0.9.24",
  "description": "Telegram bot that collects attendance and writes responses to Google Sheets.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "find src -type f -name '*.js' -print0 | xargs -0 -n 1 node --check",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "googleapis": "^173.0.0",
    "node-cron": "^4.1.0",
    "telegraf": "^4.16.3",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "gaxios": "^7.3.0"
  }
}
