# Runtime configuration for the attendance bot.
#
# Copy this file to `.env`, replace the credential placeholders, and keep the
# resulting `.env` out of source control. Values here affect deployment/runtime
# behaviour; unit structure and attendance choices belong in `settings.yaml`.

# -----------------------------------------------------------------------------
# Required credentials
# -----------------------------------------------------------------------------

# Telegram token issued by BotFather. The process cannot start without it.
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token

# ID from the Google Sheets URL. This identifies the workbook used as the shared
# attendance record; it is not the name of an individual worksheet/tab.
GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-your-google-sheet-id

# `client_email` from the Google service-account JSON key. The spreadsheet must
# be shared with this address or Sheets reads/writes will fail.
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace-with-your-service-account-email

# `private_key` from the same service-account JSON key. Keep literal `\n` escape
# sequences on one line in .env; config.js converts them back to real newlines.
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n
# -----------------------------------------------------------------------------
# Time and reminders
# -----------------------------------------------------------------------------

# IANA timezone used for attendance dates, workweeks, reminders and cron jobs.
# Asia/Singapore is the expected production setting.
BOT_TIMEZONE=Asia/Singapore

# Weekday reminder times in 24-hour HH:MM format, interpreted in BOT_TIMEZONE.
# The first pass prompts all bound users; the second prompts only users whose
# attendance is still blank. The two times must be different.
FIRST_REMINDER_TIME=07:00
SECOND_REMINDER_TIME=08:00

# -----------------------------------------------------------------------------
# Telegram broadcast pacing
# -----------------------------------------------------------------------------

# Minimum delay, in milliseconds, between launches from the process-wide
# broadcast dispatcher. This limits aggregate send rate across overlapping jobs.
TELEGRAM_BROADCAST_INTERVAL_MS=100

# Maximum number of Telegram broadcast sends allowed in flight at once.
# The code clamps this to a safe range; interactive replies still take priority.
TELEGRAM_BROADCAST_CONCURRENCY=12

# After the last interactive Telegram operation finishes, background work waits
# this many milliseconds before resuming. This prevents maintenance from taking
# capacity immediately between successive button taps.
INTERACTIVE_PRIORITY_QUIET_MS=500

# -----------------------------------------------------------------------------
# Durable attendance queue
# -----------------------------------------------------------------------------

# Maximum routine delay before pending attendance is offered for a Sheets flush.
# The acknowledgement to the user does NOT wait for this flush: the event has
# already been persisted locally in data/attendance-queue.ndjson.
ATTENDANCE_QUEUE_FLUSH_INTERVAL_MS=120000

# Flush early when this many eligible attendance events are waiting. This keeps
# bursts from sitting in the local queue until the normal interval expires.
ATTENDANCE_QUEUE_FLUSH_THRESHOLD=25

# -----------------------------------------------------------------------------
# Cache and Google Sheets pacing
# -----------------------------------------------------------------------------

# Delay nonessential snapshot refreshes for this long after a Telegram prompt
# broadcast. Cached data continues serving normal UI paths during the delay.
SNAPSHOT_REFRESH_POST_BROADCAST_DELAY_MS=30000

# Minimum spacing between Google Sheets API requests. The implementation will
# not permit a value below its safety floor even if a smaller value is supplied.
GOOGLE_SHEETS_INTER_REQUEST_DELAY_MS=1000

# Spacing used after repeated Sheets timeouts indicate congestion. Must be at
# least as large as the normal request delay.
GOOGLE_SHEETS_INTER_REQUEST_DELAY_CONGESTED_MS=3000

# Name of the worksheet that contains appointment names and onboarding codes.
# Changing this points the bot at a differently named roster tab; it does not
# rename an existing worksheet automatically.
ONBOARDING_SHEET_TITLE=ONBOARDING

# Optional plain-text application log. Under Docker Compose, /app/data is backed
# by the repository's ./data volume, so this survives container replacement.
# Leave empty/unset if file logging is not required.
LOG_FILE_PATH=/app/data/logs/attendance-bot.log

# -----------------------------------------------------------------------------
# Optional integrations and diagnostics
# -----------------------------------------------------------------------------

# Optional GitHub personal access token. When present, the bot exposes its
# in-bot issue-reporting control. Leave unset to disable that integration.
# GITHUB_TOKEN=replace-with-your-github-personal-access-token

# Debug only. When true, Sheets writes are immediately read back for verification.
# This materially increases API traffic and should normally remain false/unset.
# GOOGLE_SHEETS_VERIFY_WRITES=false

# Optional path overrides used mainly for nonstandard deployments and tests.
# SETTINGS_FILE_PATH=/absolute/path/to/settings.yaml
# ATTENDANCE_BOT_DATA_DIR=/absolute/path/to/runtime-data
# ENV_FILE_PATH=/absolute/path/to/.env
