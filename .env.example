TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace-with-your-service-account-email
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n
BOT_TIMEZONE=Asia/Singapore
FIRST_REMINDER_TIME=07:00
SECOND_REMINDER_TIME=08:00

# Telegram broadcast pacing
TELEGRAM_BROADCAST_INTERVAL_MS=100
TELEGRAM_BROADCAST_CONCURRENCY=12
INTERACTIVE_PRIORITY_QUIET_MS=500

# Attendance queue
ATTENDANCE_QUEUE_FLUSH_INTERVAL_MS=120000
ATTENDANCE_QUEUE_FLUSH_THRESHOLD=25

# Cache / Sheets pacing
SNAPSHOT_REFRESH_POST_BROADCAST_DELAY_MS=30000
GOOGLE_SHEETS_INTER_REQUEST_DELAY_MS=1000
GOOGLE_SHEETS_INTER_REQUEST_DELAY_CONGESTED_MS=3000

ONBOARDING_SHEET_TITLE=ONBOARDING
LOG_FILE_PATH=/app/data/logs/attendance-bot.log

# Optional. Enables in-bot GitHub issue reporting.
# GITHUB_TOKEN=replace-with-your-github-personal-access-token

# Debug only. Read back Sheets writes after flushing; increases API usage.
# GOOGLE_SHEETS_VERIFY_WRITES=false
